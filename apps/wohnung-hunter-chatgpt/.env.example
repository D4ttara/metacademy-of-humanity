PORT=8787

# Production Gmail ingestion is handled by the bound Google Apps Script.
# Do not put Gmail OAuth client secrets or refresh tokens here.

# Optional future server-side Sheet reader. Prefer a scoped service account
# or a private Apps Script bridge rather than a consumer OAuth refresh token.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Wohnungen

# Portal runner / server bridge secrets belong in deployment secret storage only.
PORTAL_RUNNER_SHARED_SECRET=
