    "timestamp": {"type": "string"},
    "provenance": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "claim_id": {"type": "string"},
    "observed_now": {},
    "historical_traces": {"type": "array"},
    "modalities": {"type": "array"},
    "candidate_causes": {"type": "array"},
    "contradicting_traces": {"type": "array"},
